# Supabase: Dashboard → Project Settings → API. For the local stack, run `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: bypasses RLS. Never expose it to the browser and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the restaurant that / and /cart redirect to (default: yakoyo).
DEFAULT_RESTAURANT_SLUG=
